# --- System 1: Nemotron 3.5 Lightning (fast generation) ---
NEMOTRON_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# The shared build.nvidia.com endpoint needs 45-70s for a short answer.
# A dedicated NIM endpoint is much quicker: lower this after measuring it yourself.
NEMOTRON_TIMEOUT_SECONDS=120
# Below ~600 the reasoning budget runs out and the answer comes back truncated.
NEMOTRON_MAX_OUTPUT_TOKENS=800
NEMOTRON_TEMPERATURE=0.3
# Leave false. When true the model spends hundreds of tokens on a trace of
# thought and leaks it into the answer text.
NEMOTRON_ENABLE_THINKING=false

# --- System 2: laya-coreml (deep reasoning, local Core ML runtime) ---
# Without this runtime only LOW works; MEDIUM and HARD fail with 503.
LAYA_COREML_URL=http://127.0.0.1:8081
LAYA_COREML_API_KEY=
LAYA_COREML_TIMEOUT_SECONDS=120
LAYA_COREML_MAX_INPUT_CHARS=12000
# HARD runs this many critique/revision rounds at most
LAYA_MAX_REFINEMENTS=2

# --- Storage ---
LAYA_DB_PATH=./data/laya.db

# --- Service ---
LAYA_HOST=127.0.0.1
LAYA_PORT=8000
LAYA_LOG_LEVEL=INFO