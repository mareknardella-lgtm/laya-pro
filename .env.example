# Local-only bind; public interfaces are rejected by configuration validation.
LAYA_MODE=local
LAYA_HOST=127.0.0.1
LAYA_PORT=8765

# Leave unset until an actual loopback Laya runtime and its contract are verified.
# For local open-source Laya runtime (scripts/run_local_laya.py):
# LAYA_DECISION_URL=http://127.0.0.1:8000/v1/systemone
LAYA_DECISION_URL=
# Existing local Laya CoreML/PyTorch installation path settings:
LAYA_LOCAL_PATH=C:\Users\Marek\Desktop\laya-coreml
LAYA_PYTHON_PATH=C:\Users\Marek\Desktop\laya-coreml\.venv\Scripts\python.exe
LAYA_WRAPPER_PATH=C:\Users\Marek\Desktop\laya-coreml\laya_torch.py
# Optional authentication token for Laya AI decision endpoint (Bearer auth; leave empty for local unauthenticated laya-serve)
LAYA_API_KEY=
LAYA_TIMEOUT_SECONDS=60
LAYA_MAX_INPUT_CHARS=12000
LAYA_MAX_OUTPUT_BYTES=65536

# System 2 plain-text generation provider selection: default, nvidia
SYSTEM2_PROVIDER=default

# Optional System 2 default generation endpoint (plain text only; never authorizes or executes tools).
# Leave unset until a real loopback runtime and its contract are verified.
SYSTEM2_GENERATE_URL=
SYSTEM2_TIMEOUT_SECONDS=20
SYSTEM2_MAX_INPUT_CHARS=12000
SYSTEM2_MAX_OUTPUT_BYTES=65536

# NVIDIA AI — Optional System 2 plain-text provider slot
# Plain-text generation only; never authorizes, approves, or executes actions.
NVIDIA_AI_ENABLED=false
NVIDIA_AI_PROVIDER=nvidia
NVIDIA_AI_MODEL=
NVIDIA_AI_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_AI_API_KEY=
NVIDIA_AI_TIMEOUT_SECONDS=30

LAYA_MAX_ITERATIONS=8
LAYA_PROJECT_ROOTS={}
# Example after explicit review: project:read,project:write
LAYA_ALLOWED_PERMISSIONS=
# Required to expose approval/audit controls; use a locally generated random token.
# LAYA_APPROVAL_TOKEN=
LAYA_DATABASE_PATH=backend/data/laya.sqlite3
LAYA_APPROVAL_TTL_SECONDS=900
LAYA_MAX_WORKFLOW_STEPS=32
LAYA_WORKFLOW_TIMEOUT_SECONDS=300
LAYA_MAX_FILE_BYTES=1048576
LAYA_MAX_MEMORY_VALUE_CHARS=8000

# JEV Hybrid Framework Config (System 1)
JEV_API_URL=
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=30

